local Players=game:GetService("Players");local RunService=game:GetService("RunService");local Workspace=game:GetService("Workspace");local LocalPlayer=Players.LocalPlayer;local Camera=Workspace.CurrentCamera;local TOOL_NAME="RCCar26";local CAR_FOLDER="RCCars";local isEquipped=false;local currentCar=nil;local cameraConnection=nil;local checkConnection=nil;local knownCars={};local function GetCarBody(carModel)if not carModel then return nil end local body=carModel:FindFirstChild("Body") or carModel:FindFirstChild("CarBody") or carModel.PrimaryPart;if body and body:IsA("BasePart") then return body end for _,child in ipairs(carModel:GetDescendants())do if child:IsA("BasePart")then return child end end return nil end;local function GetAllCars()local cars={};local rcFolder=Workspace:FindFirstChild(CAR_FOLDER);if rcFolder then for _,child in ipairs(rcFolder:GetChildren())do if child:IsA("Model") and string.find(child.Name,"RCCar")then cars[child]=true end end end;for _,child in ipairs(Workspace:GetChildren())do if child:IsA("Model")then if child.Name==TOOL_NAME or string.find(child.Name,"RCCar")then cars[child]=true end end end;return cars end;local function SnapshotCars()knownCars=GetAllCars()end;local function FindNewCar()local cars=GetAllCars();for car in pairs(cars)do if not knownCars[car]then return car end end return nil end;local function ActivateCarCamera(carModel)if not carModel then return end;if currentCar==carModel then return end;local body=GetCarBody(carModel);if body then currentCar=carModel;Camera.CameraSubject=body;Camera.CameraType=Enum.CameraType.Follow;print("[RCCar] Camera switched to YOUR RC car:",carModel:GetFullName())end end;local function MaintainCarCamera()if not currentCar then return false end;if currentCar.Parent then local body=GetCarBody(currentCar);if body then if Camera.CameraSubject~=body then Camera.CameraSubject=body end;if Camera.CameraType~=Enum.CameraType.Follow then Camera.CameraType=Enum.CameraType.Follow end;return true end end;re